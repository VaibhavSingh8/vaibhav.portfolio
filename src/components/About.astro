---
import { education } from '../data/education';
---

<section id="about">
  <h2 class="section t2">About</h2>
  <div class="prose">
    <p>
      At DataPOEM I work on an enterprise decision AI platform that large
      consumer brands use to plan their marketing budgets. I own the identity
      platform, lead the frontend, and build features and core services that
      clients use in production.
    </p>
    <p>
      I came to software from mechanical engineering. At TCS I went from
      testing to cloud platform support, then asked to move into React. I
      joined DataPOEM with a frontend title, the work went fullstack, and the
      title caught up in April 2026.
    </p>
  </div>

  <ul class="facts">
    {education.map((e) => (
      <li>
        <span class="k">Studied</span>
        <span>{e.title}, {e.org}</span>
        <span class="when">{e.period}</span>
      </li>
    ))}
    <li>
      <span class="k">Outside work</span>
      <span>Building a Chrome extension that carries context across AI tools. Gym five days a week, badminton twice.</span>
    </li>
  </ul>
</section>

<style>
  .prose p {
    color: var(--ink-2);
    margin: 0 0 14px;
    max-width: 40em;
    text-wrap: pretty;
  }
  .prose p:last-child {
    margin-bottom: 0;
  }
  /* subgrid so the label column lines up across rows */
  .facts {
    list-style: none;
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr) auto;
    column-gap: 20px;
    padding: 0;
    margin: 28px 0 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  .facts li {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    padding: 10px 0;
    border-top: 1px solid var(--rule-2);
  }
  .k {
    font-size: 14px;
    color: var(--ink-3);
  }
  .when {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    align-self: center;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .k {
      grid-column: 1 / -1;
    }
  }
</style>
