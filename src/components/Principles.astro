---
import { principles } from '../data/principles';
---

<section id="how-i-work">
  <h2 class="section t2">How I work</h2>
  <p class="section-intro">Each of these comes with the thing I did that shows it.</p>
  <ol class="list">
    {principles.map((p) => (
      <li>
        <p class="rule">{p.rule}</p>
        <p class="proof">{p.proof}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .list {
    list-style: none;
    counter-reset: p;
    padding: 0;
    margin: 0;
  }
  li {
    counter-increment: p;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    column-gap: 8px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-2);
  }
  li:last-child {
    border-bottom: none;
  }
  li::before {
    content: counter(p, decimal-leading-zero);
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    padding-top: 3px;
  }
  .rule {
    font-weight: 600;
    margin: 0;
  }
  .proof {
    font-size: 15px;
    color: var(--ink-2);
    margin: 4px 0 0;
    text-wrap: pretty;
  }
</style>
