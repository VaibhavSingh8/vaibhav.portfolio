---
import { connectLinks } from '../data/connect.ts';

// links without a URL stay hidden; email drives the note, the rest sit on one line
const live = connectLinks.filter((l): l is typeof l & { href: string } => l.href !== null);
const email = live.find((l) => l.href.startsWith('mailto:'));
const elsewhere = live.filter((l) => l !== email);

// each option finishes the sentence "...and I'm ___."; `subject` heads the email
const topics = [
  { say: 'hiring for a full-time role', subject: 'A full-time role' },
  { say: 'looking for help with a project', subject: 'A project' },
  { say: 'curious about something on this site', subject: 'Something on your site' },
  { say: 'just saying hi', subject: 'Just saying hi' },
];
---

<section id="connect">
  <h2 class="section t2">Contact</h2>
  <p class="section-intro">Fill in the blanks and your mail app opens with the email already written.</p>

  {email && (
    <form class="note" data-to={email.text} novalidate>
      <p class="sentence">
        Hi Vaibhav, this is
        <label class="sr-only" for="note-name">Your name</label>
        <input
          id="note-name"
          name="name"
          autocomplete="name"
          placeholder="your name"
          required
          maxlength="60"
          aria-describedby="note-hint"
        />, and I'm
        <label class="sr-only" for="note-topic">Why you're writing</label>
        <span class="pick">
          <select id="note-topic" name="topic">
            {topics.map((t) => <option value={t.subject}>{t.say}</option>)}
          </select>
        </span>.
      </p>
      <p class="hint" id="note-hint" aria-live="polite"></p>
      <label class="sr-only" for="note-more">Anything else (optional)</label>
      <textarea id="note-more" name="more" rows="1" maxlength="1200" placeholder="Anything else? (optional)"></textarea>

      <div class="actions">
        <button type="submit" class="send">
          Write the email
          <svg class="plane" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 3 3 10.5l7 2.5 2.5 7L21 3Z"></path>
            <path d="m10 13 4.5-4.5"></path>
          </svg>
        </button>
        <span class="or">
          or write to
          <a href={email.href}>{email.text}</a>
          <button type="button" class="copy" data-copy={email.text}>
            Copy<span class="sr-only"> email address</span>
          </button>
        </span>
      </div>

      <p class="fallback" hidden>
        Mail app didn't open? Write it in
        <a class="gmail" href="https://mail.google.com/" target="_blank" rel="noopener">Gmail</a>
        or
        <button type="button" class="copy copy-note">Copy the message</button>
      </p>
    </form>
  )}
  <p class="copy-status sr-only" aria-live="polite"></p>

  {elsewhere.length > 0 && (
    <ul class="elsewhere" aria-label="Elsewhere">
      {elsewhere.map(({ label, text, href, paths, filled }) => (
        <li>
          <a href={href} rel="me noopener">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill={filled ? 'currentColor' : 'none'}
              stroke={filled ? 'none' : 'currentColor'}
              stroke-width={filled ? undefined : '2'}
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {paths.map((d) => <path d={d} />)}
            </svg>
            <span class="sr-only">{label}: </span>{text}
          </a>
        </li>
      ))}
    </ul>
  )}

  <div class="status">
    <p class="availability">
      <span class="dot" aria-hidden="true"></span>
      Open to interesting work. Usually replies within a day.
    </p>
    <p class="where">
      Bengaluru<span class="clock" hidden>, <time></time></span> · remote-friendly
    </p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('#connect');
  const status = root?.querySelector<HTMLElement>('.copy-status');
  const say = (msg: string) => {
    if (status) status.textContent = msg;
  };

  const copy = (btn: HTMLButtonElement, value: string, done: string) => {
    const label = btn.firstChild;
    const original = label?.textContent ?? '';
    navigator.clipboard.writeText(value).then(
      () => {
        if (label) label.textContent = 'Copied';
        say(done);
        setTimeout(() => {
          if (label) label.textContent = original;
          say('');
        }, 2000);
      },
      () => say('Copy failed. Select the text instead.'),
    );
  };

  const form = root?.querySelector<HTMLFormElement>('.note');
  const to = form?.dataset['to'];
  const compose = () => {
    if (!form) return { subject: '', body: '' };
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const topic = String(data.get('topic') ?? '');
    const say = form.querySelector<HTMLSelectElement>('select')?.selectedOptions[0]?.text ?? '';
    const more = String(data.get('more') ?? '').trim();
    const subject = `${topic} (from ${name})`;
    const body = `Hi Vaibhav, this is ${name}, and I'm ${say}.` + (more ? `\n\n${more}` : '');
    return { subject, body };
  };

  for (const btn of root?.querySelectorAll<HTMLButtonElement>('.copy[data-copy]') ?? []) {
    btn.addEventListener('click', () => copy(btn, btn.dataset['copy'] ?? '', 'Email address copied'));
  }

  const copyNote = root?.querySelector<HTMLButtonElement>('.copy-note');
  copyNote?.addEventListener('click', () => {
    const { subject, body } = compose();
    copy(copyNote, `${subject}\n\n${body}`, 'Message copied');
  });

  // our own validation instead of the browser bubble: say it in the page's voice, nudge the blank
  const nameField = form?.querySelector<HTMLInputElement>('#note-name');
  const hint = form?.querySelector<HTMLElement>('.hint');
  const setInvalid = (on: boolean) => {
    if (!nameField || !hint) return;
    nameField.toggleAttribute('aria-invalid', on);
    hint.textContent = on ? "Add your name first, so I know who's writing." : '';
  };
  nameField?.addEventListener('input', () => {
    if (nameField.value.trim()) setInvalid(false);
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!to) return;
    if (nameField && !nameField.value.trim()) {
      setInvalid(true);
      nameField.focus();
      nameField.classList.remove('wiggle');
      void nameField.offsetWidth; // restart the wiggle
      nameField.classList.add('wiggle');
      return;
    }
    const { subject, body } = compose();
    const plane = form.querySelector('.plane');
    plane?.classList.remove('fly');
    void plane?.getBoundingClientRect(); // restart the flight
    plane?.classList.add('fly');
    window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    // for people whose mail lives in a browser tab: same email, opened in Gmail's composer
    const gmail = form.querySelector<HTMLAnchorElement>('.gmail');
    if (gmail) {
      const q = new URLSearchParams({ view: 'cm', fs: '1', to, su: subject, body });
      gmail.href = `https://mail.google.com/mail/?${q.toString()}`;
    }
    const fallback = form.querySelector<HTMLElement>('.fallback');
    if (fallback) fallback.hidden = false;
  });

  // local time in Bengaluru, so a visitor elsewhere knows when a reply is likely.
  // Rendered by JS only; without it the line reads "Bengaluru · remote-friendly".
  const clock = root?.querySelector<HTMLElement>('.clock');
  const time = clock?.querySelector('time');
  if (clock && time) {
    const fmt = new Intl.DateTimeFormat('en-IN', {
      timeZone: 'Asia/Kolkata',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    });
    const tick = () => {
      time.textContent = fmt.format(new Date()).toLowerCase() + ' IST';
    };
    tick();
    clock.hidden = false;
    setInterval(tick, 30_000);
  }
</script>

<style>
  /* the note: a sentence with blanks; the blanks are the form */
  .note {
    margin-top: 8px;
  }
  .sentence {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(21px, 3.4vw, 28px);
    line-height: 1.7;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
  }
  .sentence input,
  .sentence select,
  textarea {
    font: inherit;
    color: var(--accent-ink);
    background: transparent;
    border: 0;
    border-bottom: 1.5px dashed var(--border-control);
    border-radius: 0;
    padding: 0 2px;
    transition: border-color 0.2s;
  }
  .sentence input,
  .pick {
    margin-inline: 0.25em 0.05em;
  }
  .sentence input {
    field-sizing: content;
    min-width: 1ch;
    max-width: 100%;
  }
  /* browsers without field-sizing get a fixed blank instead */
  @supports not (field-sizing: content) {
    .sentence input {
      width: 7em;
    }
  }
  .sentence input::placeholder,
  textarea::placeholder {
    color: var(--ink-3);
  }
  .sentence input:hover,
  .sentence select:hover,
  textarea:hover {
    border-bottom-color: var(--ink-3);
  }
  /* the blank itself shows focus: solid accent line plus a faint tint, instead of the
     global ring boxing the whole field */
  .sentence input:focus-visible,
  .sentence select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--accent);
    background: var(--accent-faint);
  }
  .pick {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }
  .sentence select {
    appearance: none;
    max-width: 100%;
    padding-right: 1.1em;
    field-sizing: content;
    cursor: pointer;
    text-overflow: ellipsis;
  }
  .pick::after {
    content: "";
    position: absolute;
    right: 4px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--ink-3);
    border-bottom: 1.5px solid var(--ink-3);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  /* the menu reads at body size, not at the sentence's display size */
  .sentence select option {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink);
    background: var(--card);
  }
  @supports (appearance: base-select) {
    .sentence select,
    .sentence select::picker(select) {
      appearance: base-select;
    }
    .sentence select::picker-icon {
      display: none;
    }
    .sentence select::picker(select) {
      /* open below the blank; flip up only when it doesn't fit (the default
         picks whichever side has more room, which covers the heading) */
      position-try-order: normal;
      margin-block: 6px;
      padding: 6px;
      background: var(--card);
      color: var(--ink);
      border: 1px solid var(--rule);
      border-radius: 12px;
      box-shadow: var(--shadow);
    }
    .sentence select option {
      padding: 8px 12px;
      border-radius: 8px;
      background: transparent;
      line-height: 1.4;
      cursor: pointer;
    }
    .sentence select option:hover,
    .sentence select option:focus-visible {
      background: var(--bg-2);
      outline: none;
    }
    .sentence select option:checked {
      color: var(--accent-ink);
      font-weight: 500;
    }
    .sentence select option::checkmark {
      display: none;
    }
  }
  textarea {
    display: block;
    width: 100%;
    margin-top: 14px;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
    resize: none;
    field-sizing: content;
    min-height: 2.2em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 24px;
  }
  .send {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    color: var(--bg);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 10px 18px;
    min-height: 44px;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .send:hover .plane {
    transform: translate(2px, -2px);
  }
  .send:active {
    transform: scale(0.98);
  }
  .plane {
    width: 17px;
    height: 17px;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .plane.fly {
    animation: fly 0.9s cubic-bezier(0.5, 0, 0.75, 0) forwards;
  }
  @keyframes fly {
    40% {
      transform: translate(-3px, 3px) rotate(-6deg);
    }
    80% {
      transform: translate(60px, -46px) rotate(10deg);
      opacity: 0;
    }
    81% {
      transform: translate(-14px, 0);
      opacity: 0;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }
  .or {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 14px;
    color: var(--ink-3);
  }
  .or a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--border-control);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .or a:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }
  .copy {
    font: inherit;
    font-size: 13px;
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--border-control);
    border-radius: 6px;
    padding: 2px 9px;
    min-height: 26px;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--ink);
  }
  .hint {
    font-size: 14px;
    color: var(--accent-ink);
    margin: 6px 0 0;
  }
  .hint:empty {
    display: none;
  }
  .sentence input[aria-invalid] {
    border-bottom: 2px solid var(--accent);
  }
  .wiggle {
    animation: wiggle 0.4s ease-in-out;
  }
  @keyframes wiggle {
    20%,
    60% {
      transform: translateX(-4px);
    }
    40%,
    80% {
      transform: translateX(4px);
    }
  }
  .fallback a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--border-control);
    text-underline-offset: 4px;
  }
  .fallback a:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }
  .fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    font-size: 14px;
    color: var(--ink-3);
    margin: 14px 0 0;
  }
  .fallback[hidden] {
    display: none;
  }

  .elsewhere {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding: 0;
    margin: 36px 0 0;
  }
  .elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 28px;
    font-size: 15px;
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }
  .elsewhere a:hover {
    color: var(--ink);
    text-decoration-color: var(--border-control);
  }
  .elsewhere svg {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--ink-3);
    transition: color 0.2s;
  }
  .elsewhere a:hover svg {
    color: var(--ink);
  }

  .status {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--rule-2);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
  }
  .availability {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-2);
    margin: 0;
  }
  .where {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    margin: 0;
  }
  .where time {
    font-variant-numeric: tabular-nums;
  }
  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--live);
    box-shadow: 0 0 0 3px var(--live-ring);
    animation: pulseDot 2.2s ease-in-out infinite;
    transform: translateY(-1px);
  }
  @keyframes pulseDot {
    0%,
    100% {
      box-shadow: 0 0 0 3px var(--live-ring);
    }
    50% {
      box-shadow: 0 0 0 6px transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wiggle,
    .plane,
    .plane.fly {
      transition: none;
      animation: none;
    }
  }
</style>
