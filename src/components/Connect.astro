---
import { connectLinks } from '../data/connect.ts';
---

<section id="connect">
  <h2 class="section">Connect</h2>
  <div class="chips" id="chips">
    {connectLinks.map(({ label, href, paths, filled }) => (
      <a class="chip" href={href}>
        <span class="ico">
          <svg
            viewBox="0 0 24 24"
            fill={filled ? 'currentColor' : 'none'}
            stroke={filled ? 'none' : 'currentColor'}
            stroke-width={filled ? undefined : '2'}
          >
            {paths.map((d) => <path d={d} />)}
          </svg>
        </span>
        {label}
      </a>
    ))}
  </div>
</section>

<div class="buildstrip" aria-label="Availability">
  <span><span class="dot"></span>Open to interesting work</span>
  <span>Based in Bengaluru &middot; remote-friendly</span>
  <span>Usually replies within a day</span>
</div>

<style>
  section {
    margin-top: 36px;
    scroll-margin-top: 80px;
  }
  h2.section {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 32px;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    --ripple: transparent;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    background: var(--chip);
    color: var(--ink);
    border: 1px solid var(--chip-br);
    border-radius: 999px;
    box-shadow: var(--shadow);
    text-decoration: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition:
      transform 0.15s,
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .chip:hover {
    transform: translateY(-1px);
  }
  .chip svg {
    width: 14px;
    height: 14px;
  }
  .chip::before {
    content: "";
    position: absolute;
    left: var(--rx, 50%);
    top: var(--ry, 50%);
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.5s;
  }
  .chip:hover::before {
    opacity: 0.2;
    transform: translate(-50%, -50%) scale(40);
  }
  .chip .ico {
    display: inline-grid;
    place-items: center;
    width: 14px;
    height: 14px;
    color: var(--ink-2);
  }
  .buildstrip {
    margin-top: 36px;
    padding: 14px 22px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: repeating-linear-gradient(
      135deg,
      var(--hatch) 0 6px,
      transparent 6px 14px
    );
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 26px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .buildstrip span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .buildstrip .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #2ca76c;
    box-shadow: 0 0 0 3px color-mix(in oklab, #2ca76c 25%, transparent);
    animation: pulseDot 2.2s ease-in-out infinite;
  }
  @keyframes pulseDot {
    0%,
    100% {
      box-shadow: 0 0 0 3px color-mix(in oklab, #2ca76c 25%, transparent);
    }
    50% {
      box-shadow: 0 0 0 6px color-mix(in oklab, #2ca76c 0%, transparent);
    }
  }
</style>
