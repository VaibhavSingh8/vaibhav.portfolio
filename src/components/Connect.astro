---
import { connectLinks } from '../data/connect.ts';

// email first, then the rest in data order; links without a URL stay hidden
const links = connectLinks
  .filter((l): l is typeof l & { href: string } => l.href !== null)
  .sort((a, b) => Number(b.href.startsWith('mailto:')) - Number(a.href.startsWith('mailto:')));
---

<section id="connect">
  <h2 class="section t2">Contact</h2>
  <p class="section-intro">Email is the fastest way to reach me.</p>

  <ul class="channels">
    {links.map(({ label, text, href, paths, filled }) => {
      const isEmail = href.startsWith('mailto:');
      return (
        <li>
          <span class="label">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill={filled ? 'currentColor' : 'none'}
              stroke={filled ? 'none' : 'currentColor'}
              stroke-width={filled ? undefined : '2'}
            >
              {paths.map((d) => <path d={d} />)}
            </svg>
            {label}
          </span>
          <span class="value">
            <a href={href} rel={isEmail ? undefined : 'me noopener'}>{text}</a>
            {isEmail && (
              <button type="button" class="copy" data-copy={text}>
                Copy<span class="sr-only"> email address</span>
              </button>
            )}
          </span>
        </li>
      );
    })}
  </ul>
  <p class="copy-status sr-only" aria-live="polite"></p>

  <p class="availability">
    <span class="dot" aria-hidden="true"></span>
    Open to interesting work · Bengaluru, remote-friendly · usually replies within a day
  </p>
</section>

<script>
  const status = document.querySelector<HTMLElement>('#connect .copy-status');
  for (const btn of document.querySelectorAll<HTMLButtonElement>('#connect .copy')) {
    const original = btn.firstChild?.textContent ?? 'Copy';
    btn.addEventListener('click', () => {
      const value = btn.dataset['copy'];
      if (!value) return;
      navigator.clipboard.writeText(value).then(
        () => {
          if (btn.firstChild) btn.firstChild.textContent = 'Copied';
          if (status) status.textContent = 'Email address copied';
          setTimeout(() => {
            if (btn.firstChild) btn.firstChild.textContent = original;
            if (status) status.textContent = '';
          }, 2000);
        },
        () => {
          if (status) status.textContent = 'Copy failed. Select the address instead.';
        },
      );
    });
  }
</script>

<style>
  /* one grid, rows on subgrid, so labels and values line up across channels */
  .channels {
    list-style: none;
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 32px;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .channels li {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    min-height: 52px;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-3);
  }
  .label svg {
    width: 15px;
    height: 15px;
  }
  .value {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 14px;
    min-width: 0;
  }
  .value a {
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--border-control);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.2s;
  }
  .value a:hover {
    text-decoration-color: var(--accent);
  }
  .copy {
    font: inherit;
    font-size: 13px;
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--border-control);
    border-radius: 6px;
    padding: 3px 10px;
    min-height: 28px;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--ink);
  }
  .availability {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-3);
    margin: 20px 0 0;
  }
  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--live);
    box-shadow: 0 0 0 3px var(--live-ring);
    animation: pulseDot 2.2s ease-in-out infinite;
    transform: translateY(-1px);
  }
  @keyframes pulseDot {
    0%,
    100% {
      box-shadow: 0 0 0 3px var(--live-ring);
    }
    50% {
      box-shadow: 0 0 0 6px transparent;
    }
  }
  @media (max-width: 480px) {
    .channels {
      column-gap: 20px;
    }
    .value a {
      font-size: 16px;
    }
  }
</style>
