---
import { connectLinks } from '../data/connect.ts';

const links = connectLinks.filter(
  (l): l is typeof l & { href: string } => l.href !== null,
);
const email = links.find((l) => l.href.startsWith('mailto:'));
const others = links.filter((l) => l !== email);
---

<section id="connect">
  <h2 class="section t2">Contact</h2>
  <p class="section-intro">
    Email is the fastest way to reach me.
  </p>

  {email && (
    <a class="email" href={email.href}>{email.href.replace('mailto:', '')}</a>
  )}

  <ul class="links">
    {others.map(({ label, href, paths, filled }) => (
      <li>
        <a href={href} rel="me noopener">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill={filled ? 'currentColor' : 'none'}
            stroke={filled ? 'none' : 'currentColor'}
            stroke-width={filled ? undefined : '2'}
          >
            {paths.map((d) => <path d={d} />)}
          </svg>
          {label}
        </a>
      </li>
    ))}
  </ul>

  <p class="availability">
    <span class="dot" aria-hidden="true"></span>
    Open to interesting work · Bengaluru, remote-friendly · usually replies within a day
  </p>
</section>

<style>
  .email {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 3.6vw, 28px);
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--border-control);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.2s;
  }
  .email:hover {
    text-decoration-color: var(--accent);
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    padding: 0;
    margin: 16px 0 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    font-size: 15px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .links svg {
    width: 15px;
    height: 15px;
  }
  .availability {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-3);
    margin: 24px 0 0;
  }
  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--live);
    box-shadow: 0 0 0 3px var(--live-ring);
    animation: pulseDot 2.2s ease-in-out infinite;
    transform: translateY(-1px);
  }
  @keyframes pulseDot {
    0%,
    100% {
      box-shadow: 0 0 0 3px var(--live-ring);
    }
    50% {
      box-shadow: 0 0 0 6px transparent;
    }
  }
</style>
