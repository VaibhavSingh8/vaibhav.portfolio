---
import { education } from '../data/education';
---

<section id="education">
  <h2 class="section t3">Education</h2>
  <ul class="rows">
    {education.map((e) => (
      <li>
        <span class="title">{e.title}</span>
        <span class="org">{e.org}</span>
        <span class="period">{e.period}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding: 6px 0;
  }
  .title {
    font-weight: 500;
  }
  .org {
    color: var(--ink-2);
  }
  .period {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    margin-left: auto;
  }
</style>
