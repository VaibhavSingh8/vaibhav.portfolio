---
import { education } from '../data/education';
---

<section id="education">
  <h2 class="section">Education</h2>
  <div class="rows">
    {education.map((e) => (
      <div class="row-item">
        <div class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
        </div>
        <div>
          <div class="org">{e.org}</div>
          <div class="title">{e.title}</div>
          <div class="sub">
            <span>{e.period}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  section {
    margin-top: 36px;
    scroll-margin-top: 80px;
  }
  h2.section {
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: 32px;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
  }
  .row-item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule-2);
  }
  .row-item:last-child {
    border-bottom: none;
  }
  .ico {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: var(--ink-3);
    background: var(--card);
    border: 1px solid var(--rule);
    margin-top: 2px;
  }
  .ico svg {
    width: 10px;
    height: 10px;
  }
  .title {
    font-weight: 600;
    font-size: 14.5px;
  }
  .sub {
    font-family: "JetBrains Mono", monospace;
    color: var(--ink-3);
    font-size: 12px;
    margin-top: 2px;
  }
  .org {
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 2px;
  }
  .org::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--ink-3);
  }
</style>
