---
import { stackRows } from '../data/stack.ts';

const names = [...stackRows[1], ...stackRows[2], ...stackRows[3]].map((c) => c.name);
---

<section id="stack" data-paused="false">
  <h2 class="section t2">Stack</h2>
  <div class="stack-head">
    <p class="stack-sub">Tools I reach for when I&rsquo;m actually shipping.</p>
    <button
      type="button"
      class="marquee-toggle"
      id="marquee-toggle"
      aria-label="Pause tech stack animation"
    >
      <svg class="ico-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="7" y="5" width="3.5" height="14" rx="1"></rect>
        <rect x="13.5" y="5" width="3.5" height="14" rx="1"></rect>
      </svg>
      <svg class="ico-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5.5v13l11-6.5z"></path>
      </svg>
      <span class="label">Pause</span>
    </button>
  </div>

  <!-- the marquee repeats every chip several times, so screen readers get
       this list instead and the moving copies are hidden from them -->
  <ul class="sr-only">
    {names.map((n) => <li>{n}</li>)}
  </ul>
  <div class="marquee" data-speed="48" aria-hidden="true">
    <div class="track" data-row="1"></div>
  </div>
  <div class="marquee" data-speed="64" data-dir="reverse" aria-hidden="true">
    <div class="track" data-row="2"></div>
  </div>
</section>

<script>import '../scripts/carousel.ts'</script>

<style>
  .stack-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 18px;
  }
  .stack-sub {
    font-size: 15px;
    color: var(--ink-2);
    margin: 0;
  }

  /* pause control: WCAG 2.2.2 needs a real, keyboard-reachable mechanism,
     so hover-to-pause alone is not enough */
  .marquee-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    padding: 5px 10px;
    border: 1px solid var(--border-control);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .marquee-toggle:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .marquee-toggle:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .marquee-toggle svg {
    width: 11px;
    height: 11px;
  }
  .marquee-toggle .ico-play,
  #stack[data-paused="true"] .marquee-toggle .ico-pause {
    display: none;
  }
  #stack[data-paused="true"] .marquee-toggle .ico-play {
    display: block;
  }
  .marquee {
    overflow: hidden;
    position: relative;
    padding: 6px 0;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }
  .marquee + .marquee {
    margin-top: 10px;
  }
  .marquee .track {
    display: flex;
    gap: 10px;
    width: max-content;
    animation: marquee linear infinite;
    animation-duration: calc(var(--speed, 50) * 1s);
  }
  .marquee[data-dir="reverse"] .track {
    animation-direction: reverse;
  }
  .marquee:hover .track,
  #stack[data-paused="true"] .track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  /* the global prefers-reduced-motion rule zeroes every animation, which would
     make the Play button a no-op. If the user explicitly asks for motion here,
     honour it. */
  @media (prefers-reduced-motion: reduce) {
    #stack[data-paused="false"] .track {
      animation-duration: calc(var(--speed, 50) * 1s) !important;
      animation-iteration-count: infinite !important;
    }
  }

  :global(.stack-chip) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--card);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    white-space: nowrap;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s,
      transform 0.2s;
    flex: none;
  }
  :global(.stack-chip:hover) {
    border-color: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-1px);
  }
  :global(.stack-chip .sicon) {
    display: inline-block;
    width: 14px;
    height: 14px;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    background: var(--ink-3);
    transition: background 0.2s;
    flex: none;
  }
  :global(.marquee:hover .stack-chip .sicon) {
    background: var(--chip-color, var(--accent-ink));
  }
  :global([data-theme="dark"] .marquee:hover .stack-chip .sicon) {
    background: var(--chip-color-dark, var(--chip-color, var(--accent-ink)));
  }
  :global(.stack-chip .meta) {
    font-size: 10.5px;
    color: var(--ink-3);
    letter-spacing: 0.06em;
    padding-left: 6px;
    margin-left: 2px;
    border-left: 1px solid var(--rule-2);
  }
</style>
