---
/* Pet the cat: each press shows one real thing from outside work, then it
   goes back to sitting. Every caption is a fact from the owner. */
const captions = [
  'badminton, twice a week',
  'gym, five days a week',
  'building a Chrome extension that carries context across AI tools',
  'fuelled by chai',
];
---

<footer>
  <div class="credit">
    &copy; 2026 Vaibhav Singh<br />
    built with love, chai, and too many tabs
  </div>

  <div class="cat-wrap">
    <p class="caption" aria-live="polite"></p>
    <button
      type="button"
      class="cat"
      data-scene="0"
      data-captions={JSON.stringify(captions)}
      aria-label="Pet the cat"
    >
      <svg
        viewBox="0 0 80 42"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <!-- props, drawn in the cat's own line style; one shows per scene -->
        <g class="prop" data-for="1">
          <!-- shuttlecock -->
          <path d="M5 15 Q11 12 17 15"></path>
          <path d="M9.5 28 L5 15 M11 28 L11 13.5 M12.5 28 L17 15"></path>
          <path d="M8.5 28 L13.5 28 L13.5 30 Q11 33 8.5 30 Z"></path>
        </g>
        <g class="prop" data-for="2">
          <!-- dumbbell -->
          <rect x="1" y="20" width="4" height="12" rx="1"></rect>
          <rect x="5" y="22.5" width="2.5" height="7" rx="0.8"></rect>
          <path d="M7.5 26 L16.5 26"></path>
          <rect x="16.5" y="22.5" width="2.5" height="7" rx="0.8"></rect>
          <rect x="19" y="20" width="4" height="12" rx="1"></rect>
        </g>
        <g class="prop" data-for="3">
          <!-- laptop with too many tabs -->
          <path d="M4 14 L6 12 L9 12 L11 14 M11 14 L13 12 L16 12 L18 14"></path>
          <rect x="3" y="14" width="17" height="12" rx="1.5"></rect>
          <path d="M0.5 29.5 L22.5 29.5"></path>
          <path d="M8 19 L10 21 L8 23 M12.5 23 L15 23"></path>
        </g>
        <g class="prop" data-for="4">
          <!-- cutting chai -->
          <path d="M5 18 L18 18 L16 31 L7 31 Z"></path>
          <path d="M5.7 22.5 L17.3 22.5"></path>
          <path class="steam" d="M9 15 Q7.8 13 9 11 Q10.2 9 9 7"></path>
          <path class="steam s2" d="M14 15 Q12.8 13 14 11 Q15.2 9 14 7"></path>
        </g>

        <g transform="translate(24 0)"><g class="body">
          <!-- tiny pixel cat -->
          <path d="M8 30 L8 18 L14 12 L18 18 L30 18 L34 12 L40 18 L40 30 Z"></path>
          <circle cx="16" cy="24" r="1.2" fill="currentColor"></circle>
          <circle cx="32" cy="24" r="1.2" fill="currentColor"></circle>
          <path d="M22 27 Q24 29 26 27"></path>
          <path class="tail" d="M40 30 Q48 26 54 32"></path>
        </g></g>
      </svg>
    </button>
  </div>
</footer>

<script>
  const cat = document.querySelector<HTMLButtonElement>('footer .cat');
  const caption = document.querySelector<HTMLElement>('footer .caption');
  if (cat && caption) {
    const captions = JSON.parse(cat.dataset['captions'] ?? '[]') as string[];
    cat.addEventListener('click', () => {
      // 0 is the cat on its own; 1..n are the scenes, then back to 0
      const next = (Number(cat.dataset['scene'] ?? 0) + 1) % (captions.length + 1);
      cat.dataset['scene'] = String(next);
      caption.textContent = next === 0 ? '' : (captions[next - 1] ?? '');
      cat.classList.remove('hop');
      void cat.offsetWidth; // restart the hop
      cat.classList.add('hop');
    });
  }
</script>

<style>
  footer {
    margin-top: 72px;
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
    border-top: 1px solid var(--rule-2);
  }
  .credit {
    min-width: 0;
  }
  .cat-wrap {
    display: flex;
    align-items: end;
    gap: 12px;
    min-width: 0;
  }
  .caption {
    margin: 0 0 6px;
    max-width: 30ch;
    text-align: right;
    color: var(--ink-2);
    text-wrap: balance;
  }
  /* the only hint: shown on hover or focus while the cat is on its own */
  .cat-wrap:has(.cat[data-scene="0"]:is(:hover, :focus-visible)) .caption:empty::before {
    content: "pet the cat";
    color: var(--ink-3);
  }
  .cat {
    flex: none;
    padding: 4px;
    margin: -4px;
    background: none;
    border: 0;
    border-radius: 8px;
    color: var(--ink-3);
    cursor: pointer;
    transition: color 0.2s;
  }
  .cat:hover,
  .cat:not([data-scene="0"]) {
    color: var(--ink-2);
  }
  .cat svg {
    display: block;
    width: 80px;
    height: 42px;
  }
  .prop {
    display: none;
  }
  .cat[data-scene="1"] .prop[data-for="1"],
  .cat[data-scene="2"] .prop[data-for="2"],
  .cat[data-scene="3"] .prop[data-for="3"],
  .cat[data-scene="4"] .prop[data-for="4"] {
    display: inline;
  }
  .cat.hop .body {
    animation: hop 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes hop {
    40% {
      transform: translateY(-4px);
    }
  }
  .tail {
    transform-origin: 40px 30px;
  }
  .cat:hover .tail {
    animation: swish 0.6s ease-in-out;
  }
  @keyframes swish {
    50% {
      transform: rotate(-8deg);
    }
  }
  .steam {
    animation: steam 2.4s ease-in-out infinite;
  }
  .steam.s2 {
    animation-delay: 1.2s;
  }
  @keyframes steam {
    0%,
    100% {
      opacity: 0.3;
      transform: translateY(1px);
    }
    50% {
      opacity: 1;
      transform: translateY(-1px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat.hop .body,
    .cat:hover .tail,
    .steam {
      animation: none;
    }
  }
  /* phones: the caption sits above the cat instead of beside it */
  @media (max-width: 480px) {
    .cat-wrap {
      flex: none;
      flex-direction: column;
      align-items: end;
      gap: 4px;
    }
    .caption {
      max-width: 20ch;
      margin: 0;
    }
  }
</style>
