---
import { experience } from '../data/experience';
---

<section id="experience">
  <h2 class="section">Experience</h2>
  <p class="section-intro">
    The work came first and the title followed: I joined DataPOEM as a frontend
    developer, and the role caught up in April 2026.
  </p>
  <div class="rows">
    {experience.map((e) => (
      <details class="row-item" open={e.open}>
        <summary>
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" />
              <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
            </svg>
          </span>
          <span class="head">
            <span class="org">{e.org} · {e.location}</span>
            <span class="title">{e.title}</span>
            <span class="sub">{e.period}</span>
            <span class="line">{e.summary}</span>
          </span>
          <svg class="caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <div class="body">
          <ul class="highlights">
            {e.highlights.map((h) => <li>{h}</li>)}
          </ul>
          <ul class="tags" aria-label="Stack">
            {e.tags.map((t) => <li class="tag">{t}</li>)}
          </ul>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .row-item {
    border-bottom: 1px solid var(--rule-2);
    /* lets ::details-content animate to height: auto where supported */
    interpolate-size: allow-keywords;
  }
  .row-item:last-child {
    border-bottom: none;
  }
  summary {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: 12px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .row-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 0.35s allow-discrete;
  }
  .row-item[open]::details-content {
    block-size: auto;
  }
  .ico {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: var(--ink-3);
    background: var(--card);
    border: 1px solid var(--rule);
    margin-top: 2px;
  }
  .ico svg {
    width: 10px;
    height: 10px;
  }
  .head {
    display: block;
    min-width: 0;
  }
  .head > span {
    display: block;
  }
  .org {
    font-size: 13px;
    color: var(--ink-3);
    margin-bottom: 2px;
  }
  .title {
    font-weight: 600;
    font-size: 17px;
  }
  .head > .sub {
    font-family: var(--font-mono);
    color: var(--ink-3);
    font-size: 12px;
    margin-top: 2px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .line {
    font-size: 15px;
    color: var(--ink-2);
    margin-top: 8px;
    max-width: 62ch;
  }
  .caret {
    align-self: start;
    margin-top: 6px;
    color: var(--ink-3);
    transition: transform 0.25s;
  }
  .row-item[open] .caret {
    transform: rotate(180deg);
  }
  summary:hover .caret {
    color: var(--ink);
  }
  .body {
    padding: 0 0 18px 32px;
  }
  .highlights {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
    max-width: 64ch;
  }
  .highlights li {
    font-size: 15px;
    color: var(--ink-2);
  }
  .highlights li::marker {
    color: var(--ink-3);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
    background: var(--card-soft);
  }
  @media (max-width: 680px) {
    .body {
      padding-left: 0;
    }
  }
</style>
