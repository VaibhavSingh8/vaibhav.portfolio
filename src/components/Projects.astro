---
import { getCollection } from 'astro:content';

const entries = await getCollection('work', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
entries.sort((a, b) => a.data.order - b.data.order);

const caseStudies = entries.filter((e) => e.data.format === 'case-study');
const notes = entries.filter((e) => e.data.format === 'note');

/** "a · b · c" in frontmatter -> a list of figures, each keeping its scope */
const figures = (outcome: string) => outcome.split(' · ').map((f) => f.trim());
---

<section id="projects">
  <h2 class="section">Selected work</h2>
  <p class="section-intro">
    Most of my work sits behind enterprise sign-in, so it's written up here
    instead. Clients are anonymised.
  </p>

  <div class="projects">
    {caseStudies.map((entry) => (
      <article class="proj">
        <p class="kicker">
          {entry.data.kicker}
          {entry.data.status !== 'shipped' && <span class="status">{entry.data.status}</span>}
          {entry.data.draft && <span class="status">draft</span>}
        </p>
        <h3>
          <a href={`/work/${entry.id}`} style={`view-transition-name: case-${entry.id}`}>
            {entry.data.title}
          </a>
        </h3>
        <ul class="figures">
          {figures(entry.data.outcome).map((f) => <li>{f}</li>)}
        </ul>
        <span class="cta" aria-hidden="true">Read the case study &rarr;</span>
      </article>
    ))}
  </div>

  {notes.length > 0 && (
    <>
      <h3 class="sub">Smaller pieces</h3>
      <div class="notes">
        {notes.map((entry) => (
          <details class="note">
            <summary>
              <span class="note-title">{entry.data.title}</span>
              {entry.data.status !== 'shipped' && <span class="status">{entry.data.status}</span>}
              <span class="plus" aria-hidden="true"></span>
            </summary>
            <div class="note-body">
              <p class="note-summary">{entry.data.summary}</p>
              <p class="note-outcome">{entry.data.outcome}</p>
            </div>
          </details>
        ))}
      </div>
    </>
  )}
</section>

<style>
  .projects {
    display: grid;
    gap: 16px;
  }

  /* case study card: the whole card is the link (h3 a::after covers it) */
  .proj {
    position: relative;
    padding: 24px;
    border: 1px solid var(--rule);
    background: var(--card);
    border-radius: 14px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .proj:hover {
    border-color: var(--accent-edge);
    transform: translateY(-2px);
  }
  .proj:has(h3 a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-3);
    margin: 0;
  }
  .status {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 4px 7px;
    color: var(--accent-ink);
    background: var(--accent-faint);
    border: 1px solid var(--accent-edge);
    border-radius: 6px;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 23px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 8px 0 0;
    text-wrap: balance;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 14px;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .figures {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 16px 0 0;
  }
  .figures li {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    padding: 4px 9px;
    /* page colour inset into the card, so chips read in both themes */
    background: var(--bg);
    border: 1px solid var(--rule-2);
    border-radius: 6px;
  }
  .cta {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .proj:hover .cta {
    color: var(--accent-ink);
  }

  /* smaller pieces: one line each, detail on demand */
  h3.sub {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-3);
    margin: 48px 0 4px;
  }
  .note {
    border-bottom: 1px solid var(--rule-2);
    interpolate-size: allow-keywords;
  }
  .note:last-child {
    border-bottom: none;
  }
  .note summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
  }
  .note summary::-webkit-details-marker {
    display: none;
  }
  .note-title {
    font-size: 15.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .plus {
    margin-left: auto;
    flex: none;
    width: 16px;
    text-align: center;
    font-family: var(--font-mono);
    color: var(--ink-3);
  }
  .plus::before {
    content: "+";
  }
  .note[open] .plus::before {
    content: "−";
  }
  .note summary:hover .note-title {
    text-decoration: underline;
    text-decoration-color: var(--border-control);
    text-underline-offset: 4px;
  }
  .note::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 0.3s allow-discrete;
  }
  .note[open]::details-content {
    block-size: auto;
  }
  .note-body {
    padding: 0 0 16px;
    max-width: 40em;
  }
  .note-summary {
    font-size: 15px;
    color: var(--ink-2);
    margin: 0;
    text-wrap: pretty;
  }
  .note-outcome {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    margin: 8px 0 0;
  }
</style>
