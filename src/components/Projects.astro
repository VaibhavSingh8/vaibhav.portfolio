---
import { getCollection } from 'astro:content';

const entries = await getCollection('work', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
entries.sort((a, b) => a.data.order - b.data.order);

const caseStudies = entries.filter((e) => e.data.format === 'case-study');
const notes = entries.filter((e) => e.data.format === 'note');
/* the first few notes show; the rest wait behind a disclosure so the case
   studies stay the heaviest thing in the section */
const NOTES_SHOWN = 4;
const shownNotes = notes.slice(0, NOTES_SHOWN);
const moreNotes = notes.slice(NOTES_SHOWN);

/** "a · b · c" in frontmatter -> a list of figures, each keeping its scope */
const figures = (outcome: string) => outcome.split(' · ').map((f) => f.trim());
---

<section id="projects">
  <h2 class="section">Selected work</h2>
  <p class="section-intro">
    Most of my work is behind enterprise SSO, so it lives here as write-ups
    rather than repositories. Clients are anonymised and company internals are
    left out.
  </p>

  <div class="projects">
    {caseStudies.map((entry) => (
      <article class="proj">
        <p class="kicker">
          {entry.data.kicker}
          {entry.data.status !== 'shipped' && <span class="status">{entry.data.status}</span>}
          {entry.data.draft && <span class="status">draft</span>}
        </p>
        <h3>
          <a href={`/work/${entry.id}`} style={`view-transition-name: case-${entry.id}`}>
            {entry.data.title}
          </a>
        </h3>
        <p class="summary">{entry.data.summary}</p>
        <ul class="figures">
          {figures(entry.data.outcome).map((f) => <li>{f}</li>)}
        </ul>
        <span class="cta" aria-hidden="true">Read the case study &rarr;</span>
      </article>
    ))}
  </div>

  {notes.length > 0 && (
    <>
      <h3 class="sub">Also</h3>
      <ul class="notes">
        {shownNotes.map((entry) => (
          <li class="note">
            <p class="note-title">
              {entry.data.title}
              {entry.data.status !== 'shipped' && <span class="status">{entry.data.status}</span>}
            </p>
            <p class="note-summary">{entry.data.summary}</p>
            <p class="note-outcome">{entry.data.outcome}</p>
          </li>
        ))}
      </ul>
      {moreNotes.length > 0 && (
        <details class="more">
          <summary>{moreNotes.length} more</summary>
          <ul class="notes">
            {moreNotes.map((entry) => (
              <li class="note">
                <p class="note-title">
                  {entry.data.title}
                  {entry.data.status !== 'shipped' && <span class="status">{entry.data.status}</span>}
                </p>
                <p class="note-summary">{entry.data.summary}</p>
                <p class="note-outcome">{entry.data.outcome}</p>
              </li>
            ))}
          </ul>
        </details>
      )}
    </>
  )}
</section>

<style>
  .projects {
    display: grid;
    gap: 16px;
  }

  /* case study card: the whole card is the link (h3 a::after covers it) */
  .proj {
    position: relative;
    padding: 24px;
    border: 1px solid var(--rule);
    background: var(--card);
    border-radius: 14px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .proj:hover {
    border-color: var(--accent-edge);
    transform: translateY(-2px);
  }
  .proj:has(h3 a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-3);
    margin: 0;
  }
  .status {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 4px 7px;
    color: var(--accent-ink);
    background: var(--accent-faint);
    border: 1px solid var(--accent-edge);
    border-radius: 6px;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 23px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 8px 0 0;
    text-wrap: balance;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 14px;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .summary {
    color: var(--ink-2);
    font-size: 15px;
    margin: 10px 0 0;
    text-wrap: pretty;
  }
  .figures {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 16px 0 0;
  }
  .figures li {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    padding: 5px 9px;
    background: var(--bg-2);
    border-radius: 6px;
  }
  .cta {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .proj:hover .cta {
    color: var(--accent-ink);
  }

  /* everything else: plain rows, because none of them is clickable */
  h3.sub {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-3);
    margin: 40px 0 0;
  }
  .notes {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .note {
    padding: 16px 0;
    border-bottom: 1px solid var(--rule-2);
  }
  .note:last-child {
    border-bottom: none;
  }
  .note-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 16px;
    margin: 0;
  }
  .note-summary {
    font-size: 15px;
    color: var(--ink-2);
    margin: 4px 0 0;
    text-wrap: pretty;
  }
  .more summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary::after {
    content: "+";
    font-family: var(--font-mono);
    color: var(--ink-3);
  }
  .more[open] summary::after {
    content: "−";
  }
  .more summary:hover {
    color: var(--ink);
  }
  .note-outcome {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    margin: 6px 0 0;
  }
</style>
