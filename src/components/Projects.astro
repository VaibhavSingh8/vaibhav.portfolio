---
import { getCollection } from 'astro:content';

const entries = await getCollection('work', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
entries.sort((a, b) => a.data.order - b.data.order);
---

<section id="projects">
  <h2 class="section">Selected work</h2>
  <p class="section-note">
    Most of my work is behind enterprise SSO, so these are write-ups rather
    than repositories.
  </p>

  <div class="projects">
    {entries.map((entry) => (
      <article class="proj">
        <div class="thumb">
          <span class="badge">{entry.data.status}</span>
          {entry.data.thumbLabel ?? entry.data.title}
        </div>
        <div class="body">
          <div class="kicker">{entry.data.kicker}</div>
          <h3>
            <a href={`/work/${entry.id}`}>{entry.data.title}</a>
          </h3>
          <p>{entry.data.summary}</p>
          <p class="outcome">{entry.data.outcome}</p>
          <div class="actions">
            <a href={`/work/${entry.id}`} class="chip">read case study &rarr;</a>
            {entry.data.links.map((l) => (
              <a href={l.href} class="chip">{l.label}</a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .section-note {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
    margin: -8px 0 18px;
  }
  .projects {
    display: grid;
    gap: 14px;
  }
  .proj {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 18px;
    padding: 18px;
    border: 1px solid var(--rule);
    background: var(--card);
    border-radius: 14px;
    box-shadow: var(--shadow);
    transition:
      transform 0.2s,
      border-color 0.2s;
    position: relative;
    overflow: hidden;
  }
  .proj:hover {
    transform: translateY(-2px);
    border-color: var(--accent-edge);
  }
  .proj::after {
    content: "";
    position: absolute;
    inset: auto -1px -1px auto;
    width: 40px;
    height: 40px;
    background: repeating-linear-gradient(
      135deg,
      var(--hatch) 0 4px,
      transparent 4px 8px
    );
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
    opacity: 0.5;
  }
  .thumb {
    aspect-ratio: 4/3;
    border-radius: 10px;
    background-color: var(--bg-2);
    background-image: repeating-linear-gradient(
      45deg,
      var(--hatch) 0 6px,
      transparent 6px 12px
    );
    border: 1px solid var(--rule);
    position: relative;
    display: grid;
    place-items: center;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    overflow: hidden;
  }
  .thumb .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 8px;
    font-size: 10.5px;
    background: var(--bg);
    color: var(--ink-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h3 a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .outcome {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent-ink);
    margin: 0 0 10px;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    margin: 2px 0 4px;
    letter-spacing: -0.01em;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  p {
    color: var(--ink-2);
    font-size: 13.5px;
    margin: 8px 0 10px;
  }
  .actions {
    display: flex;
    gap: 8px;
    margin-top: 6px;
  }
  .actions .chip {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 5px 12px;
    border: 1px solid var(--border-control);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink-2);
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
  }
  .actions .chip:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 680px) {
    .proj {
      grid-template-columns: 1fr;
    }
  }
</style>
