---
import { getCollection } from 'astro:content';

const entries = await getCollection('work', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
entries.sort((a, b) => a.data.order - b.data.order);

const caseStudies = entries.filter((e) => e.data.format === 'case-study');
const notes = entries.filter((e) => e.data.format === 'note');
---

<section id="projects">
  <h2 class="section">Selected work</h2>
  <p class="section-note">
    Most of my work is behind enterprise SSO, so these are write-ups rather
    than repositories. Clients are anonymised and numbers keep their scope.
  </p>

  <div class="projects">
    {caseStudies.map((entry) => (
      <article class="proj">
        <div class="head">
          <span class="kicker">{entry.data.kicker}</span>
          <span class="badge">{entry.data.status}</span>
        </div>
        <h3>
          <a href={`/work/${entry.id}`}>{entry.data.title}</a>
        </h3>
        <p class="summary">{entry.data.summary}</p>
        <p class="outcome">{entry.data.outcome}</p>
        <span class="cta" aria-hidden="true">Read the case study &rarr;</span>
      </article>
    ))}
  </div>

  {notes.length > 0 && (
    <>
      <h3 class="sub">More work</h3>
      <ul class="notes">
        {notes.map((entry) => (
          <li class="note">
            <div class="note-head">
              <span class="kicker">{entry.data.kicker}</span>
              {entry.data.status !== 'shipped' && (
                <span class="badge">{entry.data.status}</span>
              )}
            </div>
            <p class="note-title">{entry.data.title}</p>
            <p class="summary">{entry.data.summary}</p>
            <p class="outcome">{entry.data.outcome}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</section>

<style>
  .section-note {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
    margin: -8px 0 18px;
  }
  .projects {
    display: grid;
    gap: 14px;
  }

  /* a case study card — the whole card is the link (see h3 a::after) */
  .proj {
    position: relative;
    padding: 22px 22px 20px;
    border: 1px solid var(--rule);
    background: var(--card);
    border-radius: 14px;
    box-shadow: var(--shadow);
    transition:
      transform 0.2s,
      border-color 0.2s;
  }
  .proj:hover {
    transform: translateY(-2px);
    border-color: var(--accent-edge);
  }
  .head,
  .note-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .badge {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 2px 8px;
    color: var(--ink-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 8px 0 0;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .proj:hover h3 a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .proj:has(h3 a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .summary {
    color: var(--ink-2);
    font-size: 14px;
    margin: 8px 0 0;
  }
  .outcome {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent-ink);
    margin: 10px 0 0;
  }
  .cta {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-2);
  }

  /* notes — plain rows, not cards, because they are not clickable */
  h3.sub {
    font-size: 18px;
    margin: 36px 0 4px;
  }
  .notes {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .note {
    padding: 16px 0;
    border-bottom: 1px solid var(--rule-2);
  }
  .note:last-child {
    border-bottom: none;
  }
  .note-title {
    font-weight: 600;
    font-size: 15px;
    margin: 4px 0 0;
  }
  .note .summary {
    font-size: 13.5px;
    margin-top: 4px;
  }
  .note .outcome {
    margin-top: 6px;
  }
</style>
