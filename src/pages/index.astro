---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Hatch from "../components/Hatch.astro";
import About from "../components/About.astro";
import Connect from "../components/Connect.astro";
import Stack from "../components/Stack.astro";
import ContribGrid from "../components/ContribGrid.astro";
import Projects from "../components/Projects.astro";
---

<Layout>
  <Nav />
  <main>
    <div class="dot-grid" aria-hidden="true"></div>
    <Hero />
    <Hatch mark="01" label="§ 01" />
    <About />
    <Hatch mark="02" label="⏃ link" />
    <Connect />
    <Hatch mark="04" label="◇ stack" />
    <Stack />
    <Hatch mark="03" label="⟊ graph" />
    <ContribGrid />
    <Hatch mark="04" label="✦ work" />
    <Projects />
  </main>
</Layout>
