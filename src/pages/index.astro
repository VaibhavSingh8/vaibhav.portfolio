---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import About from "../components/About.astro";
import Stack from "../components/Stack.astro";
import Connect from "../components/Connect.astro";
import Footer from "../components/Footer.astro";
---

<!-- The home page is an index: the work first, then just enough context.
     Detail lives on the case study pages and inside the expandable rows.
     Sections are separated by space, not rules. -->
<Layout>
  <Nav />
  <main id="main" tabindex="-1">
    <div class="dot-grid" aria-hidden="true"></div>
    <Hero />
    <Projects />
    <Experience />
    <About />
    <Stack />
    <Connect />
    <Footer />
  </main>
</Layout>
