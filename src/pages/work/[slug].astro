---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ValidatorDemo from '../../components/ValidatorDemo.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = (
    await getCollection(
      'work',
      ({ data }) =>
        data.format === 'case-study' && (import.meta.env.PROD ? !data.draft : true),
    )
  ).sort((a, b) => a.data.order - b.data.order);

  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // wraps around; undefined when this is the only case study
      next: entries.length > 1 ? entries[(i + 1) % entries.length] : undefined,
    },
  }));
};

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'> | undefined;
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const { title, kicker, summary, outcome, role, team, period, stack, status, draft } =
  entry.data;
const figures = outcome.split(' · ').map((f) => f.trim());
---

<Layout title={`${title} — Vaibhav Singh`} description={summary} type="article">
  <Nav />
  <main id="main" tabindex="-1">
    <article class="case">
      <a class="back" href="/#projects">&larr; All work</a>

      {draft && <p class="draft-flag">Draft — not included in production builds.</p>}

      <header class="head">
        <p class="kicker">
          {kicker}
          {status !== 'shipped' && <span class="status">{status}</span>}
        </p>
        <h1 style={`view-transition-name: case-${entry.id}`}>{title}</h1>
        <p class="lede">{summary}</p>
        <ul class="figures" aria-label="Headline results">
          {figures.map((f) => <li>{f}</li>)}
        </ul>
        <dl class="meta">
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          {team && (
            <div>
              <dt>Team</dt>
              <dd>{team}</dd>
            </div>
          )}
          {period && (
            <div>
              <dt>When</dt>
              <dd>{period}</dd>
            </div>
          )}
          {stack.length > 0 && (
            <div class="wide">
              <dt>Stack</dt>
              <dd>{stack.join(' · ')}</dd>
            </div>
          )}
        </dl>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="after" aria-label="More case studies">
        <a href="/#projects">&larr; All work</a>
        {next && (
          <a class="next" href={`/work/${next.id}`}>
            <span class="label">Next case study</span>
            <span class="title">{next.data.title} &rarr;</span>
          </a>
        )}
      </nav>
    </article>
    <Footer />
  </main>
</Layout>

<ValidatorDemo />

<style>
  .case {
    padding-top: 28px;
  }
  .back,
  .after > a:first-child {
    font-size: 14px;
    color: var(--ink-3);
    text-decoration: none;
  }
  .back:hover,
  .after > a:first-child:hover {
    color: var(--ink);
  }
  .draft-flag {
    font-size: 14px;
    color: var(--accent-ink);
    background: var(--accent-faint);
    border: 1px solid var(--accent-edge);
    border-radius: 8px;
    padding: 8px 12px;
    margin: 16px 0 0;
  }
  .head {
    margin-top: 28px;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--ink-3);
    margin: 0;
  }
  .status {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 4px 7px;
    color: var(--accent-ink);
    background: var(--accent-faint);
    border: 1px solid var(--accent-edge);
    border-radius: 6px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 4.6vw, 44px);
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin: 10px 0 0;
    text-wrap: balance;
  }
  .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink);
    margin: 16px 0 0;
    max-width: 38em;
    text-wrap: pretty;
  }
  .figures {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 20px 0 0;
  }
  .figures li {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 6px 10px;
    background: var(--bg-2);
    border-radius: 6px;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px 24px;
    margin: 28px 0 0;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .meta .wide {
    grid-column: 1 / -1;
  }
  .meta dt {
    font-size: 13px;
    color: var(--ink-3);
  }
  .meta dd {
    margin: 2px 0 0;
    font-size: 15px;
    color: var(--ink);
  }

  /* the markdown body: about 70 characters a line */
  .prose {
    max-width: 40rem;
    margin-top: 40px;
    font-size: 17px;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 48px 0 14px;
  }
  .prose :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin: 32px 0 8px;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .prose :global(p) {
    margin: 0 0 16px;
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
    margin: 0 0 16px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li::marker) {
    color: var(--ink-3);
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-2);
    border-radius: 4px;
    padding: 1px 5px;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    margin: 8px 0 20px;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th) {
    text-align: left;
    font-weight: 600;
    color: var(--ink);
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--rule);
  }
  .prose :global(td) {
    vertical-align: top;
    color: var(--ink-2);
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--rule-2);
  }
  .prose :global(td:first-child) {
    color: var(--ink);
    min-width: 12em;
  }

  /* deep dives: collapsible, so a skimmer can step over them */
  .prose :global(details) {
    margin: 12px 0;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--card);
  }
  .prose :global(summary) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .prose :global(summary::-webkit-details-marker) {
    display: none;
  }
  .prose :global(summary::after) {
    content: "+";
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--ink-3);
  }
  .prose :global(details[open] > summary::after) {
    content: "−";
  }
  .prose :global(details > :not(summary)) {
    margin-left: 16px;
    margin-right: 16px;
  }
  .prose :global(details > :last-child) {
    margin-bottom: 16px;
  }

  .after {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .next {
    text-align: right;
    text-decoration: none;
    color: var(--ink);
  }
  .next .label {
    display: block;
    font-size: 13px;
    color: var(--ink-3);
  }
  .next .title {
    font-weight: 600;
  }
  .next:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
